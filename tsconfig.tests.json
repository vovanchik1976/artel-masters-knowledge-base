    "src/ui/DownloadAction.ts",
    "src/ui/DownloadCancelFinal.ts",
    "src/ui/JanitorPolicy.ts",
    "src/ui/format.ts",
    "src/ui/headerBalance.ts",
    "src/ui/downloadParts.ts",
    "src/search/SearchPolicy.ts",
    "src/search/facetLabels.ts",
    "src/ui/MediaGallery.ts",
    "src/ui/MediaAuth.ts",
    "src/ui/MediaLightbox.ts",
    "src/ui/MediaTdlib.ts",
    "src/ui/MediaFetch.ts",
    "src/ui/CardMediaUploader.ts",
    "src/ui/CardMediaPanel.ts",
    "src/ui/CardMediaQueue.ts",
    "src/ui/MediaSize.ts",
    "src/ui/ProgressRing.ts",
